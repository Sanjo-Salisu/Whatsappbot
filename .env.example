# Google Sheet ID:
# From: https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# Local development: download your Google service-account JSON key into this
# project folder and name it service-account.json.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Render: set this to the complete JSON contents of the service-account key
# as a secret environment variable (or base64-encode the JSON first).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: override Puppeteer's automatically resolved Chrome executable path.
# Leave blank to use the Chrome installed in PUPPETEER_CACHE_DIR.
PUPPETEER_EXECUTABLE_PATH=

# Render: use the persistent disk mount. Leave blank locally.
BOT_DATA_DIR=

# Easiest first setup: enter the exact WhatsApp group name.
WHATSAPP_GROUP_NAME=My Family Group

# After running "npm run groups", you can paste the exact group ID here.
# If set, this takes priority over WHATSAPP_GROUP_NAME.
WHATSAPP_GROUP_ID=

# Google Sheet ranges
PEOPLE_RANGE=People!A:G
EVENTS_RANGE=Events!A:E

# Daily posting time
TIMEZONE=Africa/Lagos
POST_HOUR=8
POST_MINUTE=0

# Optional features
POST_MONTHLY_LIST=true
WELCOME_NEW_MEMBERS=false
